# =============================================================================
# Autonomous Video Surveillance Agents (AVSA) - Environment Configuration
# =============================================================================

# ── LLM Reporting ────────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# If left empty, system gracefully falls back to template-based reports.
GEMINI_API_KEY=

# ── Server Configuration ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ── Pipeline & Detection Settings ────────────────────────────────────────────
# Process every Nth frame (3 = ~10 FPS from 30 FPS video, ideal for RTX 4050/30xx)
FRAME_SKIP=3
CONFIDENCE_THRESHOLD=0.5
ANOMALY_THRESHOLD=0.65
MAX_VIDEO_DURATION=3600

# ── Model & Acceleration ─────────────────────────────────────────────────────
YOLO_MODEL=yolov8m.pt
USE_FP16=True
CUDA_DEVICE=0

# ── Storage Directories ──────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DATABASE_URL=sqlite+aiosqlite:///./surveillance.db

# ── Email Alerts (Optional) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
